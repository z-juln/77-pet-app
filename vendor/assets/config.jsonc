// 所有宠物共用的默认配置。某一只宠物自己的人设、表情包、动画和默认实例
// 放在 vendor/pets/<宠物名>/，不要写进这个文件。
// 种类目录里若写了同名字段，以种类目录为准。
{
  // ===================== 对话记忆轮数（全局默认；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 右键菜单「对话」弹窗与桌宠聊天时，每次请求携带的最近历史轮数（1 轮 = 1 问 1 答）。
  // memory.json 全存不删，此值只决定"每次请求截取多少进上下文"。非负数字；缺失默认 5，
  // 写了非法（负数/非数字）即配置错误。回落链同 whisperPrompt：种类文件顶层 → 全局 → 默认 5。
  // 设置页「AI 模型与对话上下文」区有数字输入框，改这里或那里等价（设置页写的是用户层）。
  "chatMemoryRounds": 5,
  // ===================== 碎碎念模型（全局默认：用户层写了对所有宠物生效；种类文件 pet/<名>-config.json 顶层可覆盖） =====================
  // 碎碎念用哪个服务商 + 模型生成。provider 与 model **都留空 = 跟随当前对话的模型**（默认，与旧行为一致）；
  // 想给后台自动跑的碎碎念单独用便宜/快的模型就填上（设置页有下拉框，选项与 DSH 的模型选择器同源）。
  // 只填一半（选了服务商没选模型，或反之）即配置错误 → 告警并取默认（跟随当前对话）。
  "whisperModel": { "provider": "", "model": "" },
  // ===================== 对话模型（全局默认；同上，留空 = 跟随当前对话） =====================
  // 右键菜单「对话」与桌宠聊天时用哪个服务商 + 模型。填了但调用失败（凭据被删 / 模型下架 /
  // 该服务商没配 key）会**自动回落到当前对话的模型重试一次**，仍失败才按生成失败报错。
  "chatModel": { "provider": "", "model": "" },
  // ===================== 表情包：碎碎念配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，碎碎念每次生成时从 memes 图片池随机抽 1 张，连同那句话一起显示（气泡配图）。
  // 碎碎念本身是"随口一句"，没有上下文可选，所以按随机抽（与对话的 AI 选图策略不同）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "whisperImageEnabled": true,
  // ===================== 表情包：对话配图开关（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 开启后，对话生成时把全部表情包（名称 + 描述）交给模型，由它按当前语境选 1 张；
  // 模型不选或选了不存在的图则不配图（对话配图是可选点缀，不强制每句都带）。
  // 必填布尔值；缺失即配置错误。改动后刷新或重启生效。
  "chatImageEnabled": true,
  // ===================== 表情包：对话配图张数上限（全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // 对话时发给模型的表情包清单**最多几张**（「前 N 张」= 配置里**写在前面的那 N 条**——
  // 想让哪几张优先被发出去，把它们的顺序往前挪即可；本文件里的书写顺序就是生效顺序）。
  // 为什么要它：这张清单是**每条消息都要附**的，token 随图片数量线性增长（本文件 27 张约 1.1k 字符 ≈ 650 token），
  // 张数一多就是纯烧钱——限制成前 N 张，模型只从这几张里挑，费用上限立刻可控。
  // 非负整数；**内置默认 10**（27 张的池子砍到约 1/3 开销，可选项仍够挑）；0 = 不限制（全部发）。
  // 只影响对话选图：碎碎念只带抽中的那一张，与本项无关。
  "chatImageLimit": 10,
  // ===================== 系统通知总开关 =====================
  // 对话完成 / 生成失败 / 输出截断 / 权限申请 / 用户选择 在窗口失焦时弹出系统级通知（桌面右下角）。
  // 不需要时改为 false（修改后刷新或重启生效）。必填布尔值，缺失即配置错误；
  // 也可在用户配置（main-config.jsonc）顶层覆盖，设置页保存宠物时会保留该字段。
  "notificationsEnabled": true,
  // ===================== 拖拽抛掷：锁定在当前屏幕（根字段，不属于 physics） =====================
  // 多屏用户：true = 甩出去的宠物只在松手时所在那块屏幕内弹（屏缝当墙，不飞到隔壁屏）；
  // false（默认）= 屏缝两侧都有屏时照常跨屏飞行、落到隔壁屏（现状）。
  // 放根字段而不塞进 physics：它不改手感参数（重力/恢复系数/力度那些），只改「宠物被允许去哪」。
  // 必填布尔值，缺失即配置错误；也可在用户配置（main-config.jsonc）顶层覆盖，设置页开关写的就是它。
  // 全局默认：用户层写一次对**所有宠物**生效（含种类）；种类文件 pet/<名>-config.json 顶层写了则用自己那份。
  // 仅影响桌面模式（浏览器 overlay 本来就只在视口内弹）。改动后刷新或重启生效。
  "confineToScreen": false,
  // ===================== 宠物物理（拖拽抛掷手感，全局默认，所有宠物共用；种类文件顶层可覆盖） =====================
  // gravity：抛掷下落/反弹的基础重力（px/s²）。默认 1400（数值越大落得越快）；0 = 无重力（合法，
  //   抛掷后匀速直线飞行/永不回落，配合 restitution/groundFriction=0 即纯无重力漂浮）。
  // restitution：碰壁反弹恢复系数，0~1（1 = 完全弹性，0 = 撞上即停；墙/地共用）。默认 0.78。
  // groundFriction：落地时水平速度的衰减率（/s，0 = 无摩擦冰面）。默认 2.5。
  // ceilingBounce：顶部是否反弹。true = 碰顶反弹（现状）；false = 顶部无边界，
  //   抛掷可飞出屏幕顶部（超出可视区域，重力仍会拉回落）。默认 true。
  // throwPower：总力度（拖拽/抛掷输出增益）。弹簧跟手（K/C）、甩抛初速与软上限 3600 整体 ×p：
  //   1.0 = 现状；>1 = 跟手更贴、甩得更猛、可达到的上限更高；<1 = 松弛、更易温柔放下。必须 > 0。
  // petCollision：多宠物互相碰撞开关。true = 飞行中被甩出的宠物撞到其它宠物时，
  //   按动量守恒 + 恢复系数 0.995 弹开（质量 ∝ size²）；false = 关闭（默认，宠物互相穿过）。
  "physics": {
    "gravity": 1400,
    "restitution": 0.78,
    "groundFriction": 2.5,
    "ceilingBounce": true,
    "throwPower": 1.0,
    "petCollision": false
  },
  // ===================== 事件触发周期（全局默认：用户层写一次对所有宠物生效，种类文件顶层可覆盖） =====================
  // 事件名 → 刷新间隔（秒）。**整段替换**：写了就整段用自己的，缺的键不会从内置默认补回来。
  //   · whisper：碎碎念周期，按宠物所属条目读（种类可覆盖）；读不到按 300 兜底。
  //   · balance：余额数据刷新 + 余额动画触发的间隔，**消费端只读 main 条目**（余额数据一份、
  //     host 只有一个定时器，给不了每个种类一个周期）；读不到按 1800 兜底。启动时立即触发一次。
  // 非法数值（非正数/非数字）即整段配置错误 → 告警并回退内置默认。
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 300
  }
}
