{
  "name": "dsh-pet-app",
  "version": "0.0.1",
  "private": true,
  "description": "独立桌宠（macOS / Windows）。动画与交互来自 https://github.com/PC2005-cloud/dsh-pet ，素材禁止商用。",
  "author": "dsh-pet-app",
  "main": "src/app-main.cjs",
  "scripts": {
    "build:core": "esbuild vendor/shared/index.ts --bundle --format=iife --global-name=PetShared --outfile=vendor/electron-helper/shared-core.js --platform=browser",
    "prestart": "npm run build:core",
    "start": "electron src/app-main.cjs",
    "test": "node --test src/*.test.mjs",
    "predist": "npm run build:core",
    "dist": "electron-builder --mac dmg zip --arm64 --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "app.dshpet.desktop",
    "productName": "DSH Pet",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json",
      "!vendor/shared/**/*.test.ts",
      "!**/.DS_Store"
    ],
    "asarUnpack": [
      "vendor/assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Pet",
      "unicode": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.10"
  }
}
